# PostgreSQL connection string for Nuverther Witness/Relay/Shard nodes
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"
POSTGRES_PASSWORD="nuverther_dev_pg"

# Node identity & HTTP binding
NUVERTHER_PEER_ID="witness-01"
NUVERTHER_HOST="0.0.0.0"
NUVERTHER_PORT="3000"
NUVERTHER_DB_SCHEMA="witness_01"
NUVERTHER_PUBLIC_ENDPOINT="http://127.0.0.1:3000"

# Deterministic cluster key derivation seed (optional; omit for ephemeral CSPRNG node keys)
NUVERTHER_NODE_SEED="nuverther-cluster-seed"

# Hash-Cash admission difficulty in leading zero bits
NUVERTHER_HASHCASH_BITS="16"

# Comma-separated bootstrap peer URLs for cluster discovery
NUVERTHER_BOOTSTRAP_PEERS=""

# Structured pino log level (trace|debug|info|warn|error|silent)
LOG_LEVEL="info"
